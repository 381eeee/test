<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Neon Beat Mania</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
  <style>
    * {
      user-select: none;
      -webkit-user-select: none;
      touch-action: manipulation;
    }
    body {
      font-family: 'Rajdhani', sans-serif;
      background-color: #060713;
      color: #ffffff;
      overflow: hidden;
    }
    .orbitron {
      font-family: 'Orbitron', monospace;
    }
    .neon-glow-pink {
      text-shadow: 0 0 10px #ff007f, 0 0 25px #ff007f;
    }
    .neon-glow-cyan {
      text-shadow: 0 0 10px #00f3ff, 0 0 25px #00f3ff;
    }
    .neon-border-pink {
      box-shadow: 0 0 15px rgba(255, 0, 127, 0.4), inset 0 0 10px rgba(255, 0, 127, 0.2);
    }
    .neon-border-cyan {
      box-shadow: 0 0 15px rgba(0, 243, 255, 0.4), inset 0 0 10px rgba(0, 243, 255, 0.2);
    }
    .track-active-0 { background: radial-gradient(circle at bottom, rgba(255, 59, 107, 0.35) 0%, transparent 70%); }
    .track-active-1 { background: radial-gradient(circle at bottom, rgba(0, 243, 255, 0.35) 0%, transparent 70%); }
    .track-active-2 { background: radial-gradient(circle at bottom, rgba(0, 243, 255, 0.35) 0%, transparent 70%); }
    .track-active-3 { background: radial-gradient(circle at bottom, rgba(255, 59, 107, 0.35) 0%, transparent 70%); }
    @keyframes pulse-light {
      0%, 100% { opacity: 0.8; }
      50% { opacity: 1; filter: drop-shadow(0 0 12px currentColor); }
    }
    .animate-pulse-light {
      animation: pulse-light 1.2s infinite ease-in-out;
    }
  </style>
</head>
<body class="w-screen h-screen flex items-center justify-center m-0 p-0 select-none overflow-hidden bg-slate-950">

