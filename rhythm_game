            <div class="text-cyan-400 font-bold">GREAT<br><span id="count-great" class="text-white">0</span></div>
            <div class="text-emerald-400 font-bold">GOOD<br><span id="count-good" class="text-white">0</span></div>
            <div class="text-rose-400 font-bold">MISS<br><span id="count-miss" class="text-white">0</span></div>
          </div>
        </div>

        <div class="flex w-full gap-2">
