        <!-- Rank Badge -->
        <div id="result-rank" class="orbitron text-6xl font-black my-4 text-transparent bg-clip-text bg-gradient-to-br from-yellow-300 to-amber-500 filter drop-shadow-[0_0_15px_rgba(245,158,11,0.5)]">
          S
        </div>

        <div class="w-full bg-slate-950/70 rounded-xl p-3.5 mb-4 border border-slate-800 space-y-2 text-sm">
